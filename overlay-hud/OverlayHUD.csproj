<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>OverlayHUD</AssemblyName>
    <Version>26.11.4</Version>
    <RootNamespace>OverlayHUD</RootNamespace>
    <NativeOnly Condition="'$(NativeOnly)' == ''">false</NativeOnly>
    <DefaultItemExcludes>$(DefaultItemExcludes);bin\**;obj\**;dist\**</DefaultItemExcludes>
  </PropertyGroup>

  <PropertyGroup Condition="'$(NativeOnly)' == 'true'">
    <DefineConstants>$(DefineConstants);NATIVE_ONLY</DefineConstants>
    <OutputPath>bin\NativeOnly\$(Configuration)\</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net472" Version="1.0.3" PrivateAssets="all" />
    <Compile Remove="stubs\**\*.cs" />
    <Compile Remove="BundledAppStorage.cs" Condition="'$(NativeOnly)' == 'true'" />
    <EmbeddedResource Include="NativeAssets\*" LogicalName="OverlayHUD.NativeAssets.%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\assets\fonts\*-OFL.txt" />
  </ItemGroup>

  <ItemGroup>
